{
  "name": "@moonkingdom/want-to-type",
  "version": "1.3.0",
  "description": "Typing effects, companions and sounds for DSH.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "typing",
    "effects",
    "sound"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chy1021653908/want-to-type.git"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE-upstream-effects.txt",
    "LICENSE-Barlow-Condensed.txt",
    "LICENSE-Noto-Sans-SC.txt",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.cjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
